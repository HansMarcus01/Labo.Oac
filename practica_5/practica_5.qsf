set_location_assignment PIN_A10 -to SAL[2]
set_location_assignment PIN_A9 -to SAL[1]
set_location_assignment PIN_A8 -to SAL[0]
set_location_assignment PIN_F15 -to W
set_location_assignment PIN_B14 -to X
set_location_assignment PIN_A14 -to Y
set_location_assignment PIN_A13 -to Z
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top