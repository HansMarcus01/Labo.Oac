/*<simulation_settings>
<ftestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off practica_4 -c practica_4 --vector_source="/home/hansmarcus/Desktop/clases/OAC/Labo/Labo.Oac/practica_4/Waveform.vwf" --testbench_file="/home/hansmarcus/Desktop/clases/OAC/Labo/Labo.Oac/practica_4/simulation/qsim/Waveform.vwf.vht"</ftestbench_cmd>
<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off practica_4 -c practica_4 --vector_source="/home/hansmarcus/Desktop/clases/OAC/Labo/Labo.Oac/practica_4/Waveform.vwf" --testbench_file="/home/hansmarcus/Desktop/clases/OAC/Labo/Labo.Oac/practica_4/simulation/qsim/Waveform.vwf.vht"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=vhdl --output_directory="/home/hansmarcus/Desktop/clases/OAC/Labo/Labo.Oac/practica_4/simulation/qsim/" practica_4 -c practica_4</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=vhdl --output_directory="/home/hansmarcus/Desktop/clases/OAC/Labo/Labo.Oac/practica_4/simulation/qsim/" practica_4 -c practica_4</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vcom -work work practica_4.vho
vcom -work work Waveform.vwf.vht
vsim -novopt -c -t 1ps -L fiftyfivenm -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.practica_4_vhd_vec_tst
vcd file -direction practica_4.msim.vcd
vcd add -internal practica_4_vhd_vec_tst/*
vcd add -internal practica_4_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f


</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vcom -work work practica_4.vho
vcom -work work Waveform.vwf.vht
vsim -novopt -c -t 1ps -sdfmax practica_4_vhd_vec_tst/i1=practica_4_vhd.sdo -L fiftyfivenm -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.practica_4_vhd_vec_tst
vcd file -direction practica_4.msim.vcd
vcd add -internal practica_4_vhd_vec_tst/*
vcd add -internal practica_4_vhd_vec_tst/i1/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f


</modelsim_script_timing>
<hdl_lang>vhdl</hdl_lang>
</simulation_settings>*/
